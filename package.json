{
  "name": "plainview",
  "version": "0.1.0",
  "description": "Typographic reader and HTML renderer for ***plain documents (PlainType, PlainData, PlainState)",
  "type": "module",
  "bin": {
    "plainview": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "plain",
    "plaintype",
    "plaindata",
    "plainstate",
    "reader",
    "renderer"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
